<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.hines</groupId>
	<artifactId>claims-service</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>claims-service</name>
	<description>Claims Adjudication and Payout Service</description>
	<properties>
		<java.version>21</java.version>

		<!--
			Widen what SonarQube analyses.

			The Maven scanner defaults to the Java source directories, so the
			Dockerfile, the Compose file and the CI workflows are never looked at.
			That is a real blind spot: infrastructure-as-code is where hardcoded
			credentials, over-privileged containers, and unpinned images live, and
			none of those are visible to a Java analyser.

			It also matters for honesty. This project's Security rating read A
			purely because the files with findings in them were out of scope - which
			is not the same as having no findings.

			src/main rather than src/main/java so migrations under
			src/main/resources are included too.
		-->
		<sonar.sources>pom.xml,Dockerfile,compose.yaml,.github/workflows,src/main</sonar.sources>
		<sonar.tests>src/test</sonar.tests>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>

			<!--
				Exposes each dependency's resolved path as a property, so the Mockito
				JAR can be named on the command line below without hardcoding a
				version or a local repository path.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>resolve-dependency-paths</id>
						<goals>
							<goal>properties</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!--
						Two agents, and the @{...} syntax is load-bearing.

						@{argLine} is Surefire's LATE replacement: resolved when Surefire
						runs, by which time JaCoCo's prepare-agent has set the property.
						${argLine} would be interpolated during model building instead -
						before JaCoCo has run - so the agent is silently never attached and
						coverage comes out empty with no error. That exact mistake cost a
						debugging round here; the report simply said "missing execution
						data file".

						Mockito is attached explicitly because it otherwise self-attaches
						at run time, which warns today and will be disallowed by default in
						a future JDK. Free to fix now, urgent later.
					-->
					<argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
				</configuration>
			</plugin>

			<!--
				Coverage. Reported to SonarCloud, and useful on its own: the report at
				target/site/jacoco/index.html shows which branches tests never take.

				No minimum threshold is enforced. A coverage gate mostly teaches people
				to write tests that execute code without asserting anything - the number
				goes up and nothing is verified. Coverage is a diagnostic, not a target.
			-->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>verify</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
