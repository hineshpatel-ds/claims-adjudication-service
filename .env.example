# Copy to .env before running `docker compose up`.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is the template, and it is committed so anyone
# cloning the repo knows which variables exist without having to read compose.yaml.
#
# The value below is a throwaway for a database that only listens on localhost.
# Change it, and never reuse a value from here anywhere that matters.

POSTGRES_DB=claims
POSTGRES_USER=claims
POSTGRES_PASSWORD=local-dev-only-change-me
